<mujoco model="tabletop">
  <include file="panda.xml"/>
  <option timestep="0.002"/>
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <global azimuth="150" elevation="-25"/>
  </visual>
  <asset>
    <texture type="2d" name="grid" builtin="checker" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" width="300" height="300"/>
    <material name="grid" texture="grid" texrepeat="5 5"/>
  </asset>
  <worldbody>
    <light pos="0 0 2" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="2 2 0.05" material="grid"/>
    <body name="cube" pos="0.5 0 0.025">
      <freejoint name="cube_free"/>
      <geom name="cube" type="box" size="0.025 0.025 0.025" rgba="0.9 0.3 0.2 1" mass="0.1" friction="1 0.005 0.0001"/>
    </body>
    <body name="target" mocap="true" pos="0.5 0.2 0.025">
      <site name="target" size="0.03" rgba="0 0 0 0" type="sphere"/>
      <geom type="sphere" size="0.03" rgba="0.2 0.9 0.2 0.4" contype="0" conaffinity="0"/>
    </body>
  </worldbody>
</mujoco>